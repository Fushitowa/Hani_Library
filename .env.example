# Supabase Project URL, for example https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key or publishable key; never use the service-role/secret key here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only key used only by privileged admin operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Used to build password-reset callback URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
